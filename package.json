{
  "name": "auxbot",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "generate": "turbo run generate",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.5.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "tar": "^7.5.11",
      "undici": "^6.24.0",
      "minimatch": "^3.1.4",
      "path-to-regexp": "^8.4.0",
      "qs": "^6.14.2",
      "lodash": "^4.18.0",
      "brace-expansion": "^1.1.13"
    }
  }
}
