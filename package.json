{
  "name": "auxbot",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "generate": "turbo run generate",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "oxfmt": "^0.26.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "tar": "^7.5.21",
      "undici": "^6.28.0",
      "minimatch": "^3.1.4",
      "path-to-regexp": "^8.4.0",
      "qs": "^6.15.2",
      "lodash": "^4.18.0",
      "brace-expansion": "^1.1.17",
      "js-yaml": "^4.3.1",
      "ws": "^8.21.0",
      "form-data": "^4.0.6",
      "body-parser": "^2.3.0",
      "ip-address": "^10.3.1",
      "@opentelemetry/core": "^2.8.0",
      "protobufjs": "^7.6.5",
      "@protobufjs/utf8": "^1.1.1"
    }
  }
}
